DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
APP_PORT=8018

# Leave POSTGRES_HOST empty for local SQLite. Compose sets it to db.
POSTGRES_HOST=
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=replace-with-a-random-database-password

# Telegram is disabled until both values are supplied locally.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
